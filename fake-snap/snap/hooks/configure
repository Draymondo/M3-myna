#!/bin/bash -eu
# `snap set myna-fake-backend streaming=true|false`: serve the streaming script
# (one unstable hypothesis, which a client in streaming mode shows as preedit)
# or the batch one. The server reads the option at start, so restart it.
case "$(snapctl get streaming)" in
  "" | true | false) ;;
  *) echo "streaming must be true or false" >&2; exit 1 ;;
esac
snapctl restart myna-fake-backend.server
