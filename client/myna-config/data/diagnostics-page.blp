using Gtk 4.0;
using Adw 1;

template $DiagnosticsPage: Adw.NavigationPage {
  title: _("About and Diagnostics");

  child: Adw.PreferencesPage preferences_page {
    title: _("About and Diagnostics");
    icon-name: "dialog-information-symbolic";

    Adw.PreferencesGroup setup_group {
      visible: false;

      Adw.ActionRow setup_row {
        title: _("Set up Dictation");
        activatable-widget: setup_button;

        [suffix]
        Gtk.Button setup_button {
          label: _("Set up");
          action-name: "win.setup";
          valign: center;

          styles [
            "suggested-action",
          ]
        }
      }
    }

    Adw.PreferencesGroup warnings_group {
      title: _("Performance warnings");
      description: _("Something on this machine can make dictation slow or inaccurate.");
      visible: false;
    }

    Adw.PreferencesGroup report_group {
      title: _("Diagnostics");
      description: _(
        "No audio, transcript, or filesystem path is ever included."
      );

      [header-suffix]
      Gtk.Box {
        spacing: 6;

        Gtk.Button refresh_button {
          icon-name: "view-refresh-symbolic";
          tooltip-text: _("Refresh");
          valign: center;

          accessibility {
            label: _("Refresh diagnostics");
            description: _("Check this computer, Myna and every model again.");
          }
        }

        Gtk.Button copy_button {
          icon-name: "edit-copy-symbolic";
          tooltip-text: _("Copy");
          valign: center;

          accessibility {
            label: _("Copy diagnostics");
            description: _(
              "Copies a privacy-safe diagnostic report to the clipboard. Does not include audio, transcripts, or filesystem paths."
            );
          }
        }
      }

      Gtk.ScrolledWindow {
        hscrollbar-policy: automatic;
        vscrollbar-policy: automatic;
        min-content-height: 240;
        vexpand: true;
        overflow: hidden;

        styles [
          "card",
        ]

        Gtk.TextView report_view {
          editable: false;
          monospace: true;
          cursor-visible: false;
          wrap-mode: word_char;
          top-margin: 12;
          bottom-margin: 12;
          left-margin: 12;
          right-margin: 12;

          accessibility {
            label: _("Diagnostic report");
            description: _("Read-only privacy-safe diagnostic text.");
          }
        }
      }
    }
  };
}
