#!/bin/sh
# Answers the snap reads Myna Settings makes, from the fixtures one level up.
fixtures=$(dirname "$0")/..
case "$*" in
"info "*) sed "s/myna-parakeet/$2/g" "$fixtures/snap-info-parakeet.txt" ;;
"run "*" version --format=json") cat "$fixtures/modelctl-version.json" ;;
"run "*" status --format=json") cat "$fixtures/modelctl-status.json" ;;
"run "*" list-models --format=json") cat "$fixtures/modelctl-list-models.json" ;;
"run "*" list-engines --format=json") cat "$fixtures/modelctl-list-engines.json" ;;
"run "*" get") cat "$fixtures/modelctl-get.txt" ;;
*)
    echo "fixture snap cannot run: $*" >&2
    exit 1
    ;;
esac
