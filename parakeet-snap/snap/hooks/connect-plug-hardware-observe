#!/bin/bash -eu

tag="snap.$SNAP_INSTANCE_NAME.hook.connect-plug-hardware-observe"

# Stdout and stderr also go to the journal, through pipes: redirecting to
# >(...) opens /dev/fd/N with O_CREAT, which AppArmor logs as a denial.
if [ -z "${MYNA_HOOK_LOGGED:-}" ]; then
    set -o pipefail
    { MYNA_HOOK_LOGGED=1 "$0" "$@" 2>&1 1>&3 3>&- | logger --stderr --priority error --tag="$tag"; } 3>&1 \
        | logger --stderr --tag="$tag"
    exit
fi

# The install hook cannot score hardware without this plug, so a snap installed
# before it was connected (a sideload, or a store grant that arrived by refresh)
# settled on cpu. Re-select now that `--auto` can see the machine.
#
# At install, snapd auto-connects before the install hook, which selects.
engine="$(modelctl status --format=json | jq -r '.engine // empty')"
if [ -z "$engine" ]; then
    echo "no active engine yet: leaving selection to the install hook"
    exit 0
fi

# A failing connect hook makes snapd undo the connection. The driver check
# is the install hook's: modelctl cannot read the driver's CUDA version.
if python3 -m myna.server.cuda_probe 13.0; then
    modelctl use-engine --auto --assume-yes --verbose
else
    modelctl use-engine cpu --assume-yes --verbose
fi || echo "re-selecting the engine failed: keeping $engine" >&2
